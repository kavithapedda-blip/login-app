# Reference systemd unit for the login app.
#
# NOTE: The live unit on the EC2 host is generated by scripts/deploy_backend.sh
# (which injects the real JWT_SECRET / ALLOWED_ORIGINS from CI secrets). Keep the
# paths here in sync with that script: app at /home/ubuntu/app, run as 'ubuntu'.
[Unit]
Description=Practice FastAPI Login App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/backend
Environment="JWT_SECRET=change-me-to-a-long-random-secret"
Environment="ALLOWED_ORIGINS=https://your-frontend.example.com"
ExecStart=/home/ubuntu/app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
