[Unit]
Description=Practice FastAPI Login App
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/login-app/Backend
Environment="JWT_SECRET=change-me-to-a-long-random-secret"
Environment="ALLOWED_ORIGINS=https://your-frontend.example.com"
ExecStart=/opt/login-app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
